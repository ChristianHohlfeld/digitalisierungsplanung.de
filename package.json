{
  "name": "digitalisierungsplanung-state-tool",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:pwa-assets": "node scripts/build-pwa-assets.mjs",
    "build:release-version": "node scripts/write-release-version.mjs --increment",
    "server:start": "node server/server.js",
    "test": "npm run test:server && playwright test --grep @smoke --reporter=list",
    "test:server": "node --test server/*.test.js",
    "test:browser": "playwright test",
    "test:full": "npm run test:server && npm run test:browser",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  },
  "dependencies": {
    "playwright": "1.60.0"
  }
}
