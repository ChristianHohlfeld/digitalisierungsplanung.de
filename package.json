{
  "name": "zustand-process-recorder",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "build:pwa-assets": "node scripts/build-pwa-assets.mjs",
    "build:release-version": "node scripts/write-release-version.mjs --increment",
    "server:start": "node server/server.js",
    "tasks:start": "node server/task-run.js",
    "recorder:local": "node server/local-recorder-agent.js",
    "recorder:native": "node server/native-browser-recorder.js",
    "server:smoke:wss": "node server/wss-smoke.js",
    "server:smoke:wss:prod": "node server/wss-smoke.js --force-ip=198.199.83.43",
    "server:smoke:emit": "node server/emit-smoke.js",
    "server:smoke:emit:prod": "node server/emit-smoke.js --force-ip=198.199.83.43",
    "test": "npm run test:server",
    "test:server": "node --test server/*.test.js",
    "test:browser:smoke": "playwright test --grep @smoke --reporter=list",
    "test:contracts": "playwright test tests/core-contracts.spec.js --reporter=list",
    "test:full": "npm run test:server && npm run test:browser:smoke && npm run test:contracts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "dependencies": {
    "parse5": "6.0.1",
    "ws": "^8.21.0",
    "playwright": "1.60.0"
  }
}
