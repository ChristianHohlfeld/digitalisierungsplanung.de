{
  "manifest_version": 3,
  "name": "Zustand Recorder",
  "version": "1.0.0",
  "description": "Record real browser interactions into replayable Zustand state projects.",
  "permissions": ["tabs", "scripting", "storage", "activeTab", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Zustand Recorder"
  }
}
